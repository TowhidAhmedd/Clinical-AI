
# =============================================
# Clinical RAG Assistant — Environment Config
# =============================================

# --- LLM (Required) ---
GROQ_API_KEY=
# GROQ_MODEL=llama3-70b-8192
# GROQ_MODEL = "llama-3.3-70b-versatile"
GROQ_MODEL =llama-3.1-8b-instant
# GROQ_MODEL= "Qwen3 32B"

# --- Web Search (Required for no-document mode) ---
TAVILY_API_KEY=

# --- Vector Database (Optional — falls back to in-memory) ---
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=clinical-rag

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# --- Security ---
JWT_SECRET_KEY=JWT_SECRET_KEY
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
API_KEY=API_KEY

# --- App ---
BACKEND_URL=http://localhost:8000
APP_ENV=development
LOG_LEVEL=INFO
MAX_FILE_SIZE_MB=100
ALLOWED_ORIGINS=http://localhost:8501

# --- LangSmith (Optional) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=clinical-rag-assistant


# docker-compose.yml
# Dockerfile
# Dockerfile.frontend
